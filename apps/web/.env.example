# Thesis.fun — environment
#
# Copy to .env.local and fill in the required values:
#   cp apps/web/.env.example apps/web/.env.local
#
# .env.local overrides .env, matching Next.js precedence. Both are gitignored;
# only this example file is committed. Never put a real value in this file.
#
# Everything here is server-only. Nothing is exposed to the browser.

# ─── Database (Supabase, shared with the core-product developer) ─────────────
#
# Supabase dashboard -> Project Settings -> Database -> Connection string.
# Two different strings are needed, and using the wrong one for the wrong job is
# the most common way this setup breaks:
#
#   DATABASE_URL         Transaction pooler, port 6543. Used by the app.
#                        Vercel functions open many short-lived connections and
#                        would exhaust a direct connection.
#
#   DIRECT_DATABASE_URL  Direct connection, port 5432. Used only by drizzle-kit.
#                        Schema changes cannot run through the pooler.
#
# Both contain the database password. Never commit either.
DATABASE_URL=
DIRECT_DATABASE_URL=

# Local alternative (packages/db, `bunx supabase start`). One string does both
# jobs, so leave DIRECT_DATABASE_URL empty when using it:
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ─── Required ────────────────────────────────────────────────────────────────

# OpenRouter API key for the agent. https://openrouter.ai/keys
# The app will not boot without this: the agent is the product.
OPENROUTER_API_KEY=

# ─── Optional — defaults shown, uncomment only to change ─────────────────────

# Primary model for agent turns.
# AGENT_MODEL=anthropic/claude-sonnet-4.5

# Small, fast model behind the scope gate (PRD 10.8). It runs on every inbound
# message before the primary model, so keep it cheap.
# AGENT_GATE_MODEL=anthropic/claude-haiku-4.5

# Base mainnet RPC. The public endpoint is fine for development; use a keyed
# provider if you start hitting rate limits.
# BASE_RPC_URL=https://mainnet.base.org

# Legacy feed override remains declared but is unused by the SDK-backed order adapter.
# THETANUTS_ORDERS_URL=https://round-snowflake-9c31.devops-118.workers.dev/

# Public platform referrer, passed to every OptionBook quote and fill. Optional: the
# default address is declared in packages/env/src/server.ts and is used when this is unset.
# Set it only to override that default.
# THESIS_REFERRER=0x0000000000000000000000000000000000000000

# Session signing secret: required in production, optional in development/test.
# Supply a random secret of at least 32 characters through server environment settings.
SESSION_SECRET=

# Server read boundary: mock (default) or db. Database mode requires migrations.
DATA_SOURCE=mock
# Vercel sync defaults to apps/web/.env, not .env.local. Pass the intended file
# explicitly to the sync script when secrets live only in .env.local.
