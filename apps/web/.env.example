# Copy to apps/web/.env.local for development. Never commit real values.
# .env.local overrides .env; process environment overrides both.
# Vercel sync reads apps/web/.env by default, NOT .env.local.
# All schema keys are server-only; blank optional keys use schema defaults.

# Required: Supabase transaction pooler (6543) for the app.
DATABASE_URL=
# Migrations: Supabase session pooler (IPv4, 5432), or reachable direct connection.
# Optional locally; falls back to DATABASE_URL. Never use transaction pooling for migrations.
DIRECT_DATABASE_URL=
# Required in production; random signing secret of at least 32 characters
# (`openssl rand -base64 48`). Signs the session cookie; rotating it signs everyone out.
SESSION_SECRET=
# Optional read path: mock (typed fixtures) or db (server reads; needs migrations).
# Production must set db: first use rejects fixtures. TODO-OWNER: mock production previews.
DATA_SOURCE=
# Optional runtime mode; normally supplied by the runtime.
NODE_ENV=
# ─── Model provider: set ONE of the next two. ────────────────────────────────
# Preferred: Vercel AI Gateway. Every Vercel team gets renewing free credit, the
# credential is managed on a Vercel deployment, and the same "creator/model"
# identifiers below work unchanged. Vercel dashboard -> AI Gateway -> API Keys.
AI_GATEWAY_API_KEY=
# Fallback, used only when AI_GATEWAY_API_KEY is absent. Server-only.
OPENROUTER_API_KEY=
# ─── Optional — blank means the schema default in packages/env/src/server.ts ──

# Primary model for agent turns (default anthropic/claude-haiku-4.5).
# THE ID MUST MATCH THE PROVIDER THIS DEPLOYMENT ROUTES THROUGH. With
# AI_GATEWAY_API_KEY set, lib/agent/model.ts routes through Vercel AI Gateway,
# which serves 373 models and NONE with a `:free` suffix — the previous default
# `minimax/minimax-m3:free` is an OpenRouter id and failed every turn there with
# GatewayModelNotFoundError, showing the user only "Something went wrong".
# On OpenRouter a `:free` id works but is rate-limited: measured 2026-09-06,
# 50 free requests PER DAY across all :free ids (reset 00:00 UTC), then 429.
# The app's own daily caps (PRD 10.2) apply on top.
# lib/agent/model.ts now REFUSES the wrong pairing at startup (a `:free` id with
# AI_GATEWAY_API_KEY set) instead of failing every turn silently. When the agent
# misbehaves, open GET /api/agent/health: it calls no model and names the cause.
AGENT_MODEL=
# Small, fast model behind the scope gate (PRD 10.8); runs on every inbound
# message before the primary model, so keep it cheap (default anthropic/claude-haiku-4.5).
# Deliberately NOT a free model: the gate calls generateObject under a 120-token
# output cap and the route is fail-closed, so a free reasoning model that spends
# that budget thinking makes every message a 503. See packages/env/src/server.ts.
# Measured 2026-09-06: the gate now retries an UNPARSEABLE answer once in the
# loose JSON shape (lib/agent/json-shape.ts), which is what a free model needs;
# the 120-token cap is unchanged and a 402/429 is never retried.
AGENT_GATE_MODEL=
# Optional operator secret for GET /api/agent/health?probe=1, presented as the
# x-agent-probe-token header. At least 16 characters; a shorter value is refused
# at boot. Blank (the default) means the paid probe answers 403 for everyone and
# calls no model — that is the safe state, and the plain GET /api/agent/health
# stays public and free either way. Never let a monitor use ?probe=1.
AGENT_HEALTH_PROBE_TOKEN=
# Optional: Neynar API key for the "From Farcaster" rail on the feed page, sent as
# the x-api-key header (docs.neynar.com/reference/search-casts). The rail calls
# cast search, not the channel feed the older comment here cited.
# Paste the key from the Neynar developer portal verbatim; its format is not
# documented, so no example shape is given here. Blank means the rail says it is
# not configured and makes no request — nothing is ever faked.
NEYNAR_API_KEY=
# Base mainnet RPC (default https://mainnet.base.org). The public endpoint is fine
# for development; use a keyed provider if you start hitting rate limits.
BASE_RPC_URL=
# Legacy order-feed override; unused by the SDK-backed order adapter.
THETANUTS_ORDERS_URL=
# Public platform referrer, passed to every OptionBook quote and fill. The
# owner-approved default is in the schema; set this only to override it.
THESIS_REFERRER=
# Vercel sync defaults to apps/web/.env, not .env.local. Pass the intended file
# explicitly to the sync script when secrets live only in .env.local.

# ─── Developer switches (read directly by scripts and tests, not by the schema; kept
# commented so the example matches the validated keys exactly; never set in production) ──
# drizzle-kit refuses a non-loopback target unless this is 1. Set it ONLY for the
# deliberate production migration (`drizzle-kit migrate`, never `push`).
# DRIZZLE_ALLOW_REMOTE=1
# The test suites write and delete rows, so they refuse a non-loopback DATABASE_URL
# unless this is 1. Leave blank; use a local throwaway database instead.
# TEST_DATABASE_OK=1
# 1 runs the live order-book quote suite against Thetanuts over the network.
# LIVE_BOOK_TESTS=1
