# Copy to apps/web/.env.local for development. Never commit real values.
# .env.local overrides .env; process environment overrides both.
# Vercel sync reads apps/web/.env by default, NOT .env.local.
# All schema keys are server-only; blank optional keys use schema defaults.

# Required: Supabase transaction pooler (6543) for the app.
DATABASE_URL=
# Migrations: Supabase session pooler (IPv4, 5432), or reachable direct connection.
# Optional locally; falls back to DATABASE_URL. Never use transaction pooling for migrations.
DIRECT_DATABASE_URL=
# Required in production; random signing secret of at least 32 characters
# (`openssl rand -base64 48`). Signs the session cookie; rotating it signs everyone out.
SESSION_SECRET=
# Optional read path: mock (typed fixtures) or db (server reads; needs migrations).
# Production must set db: first use rejects fixtures. TODO-OWNER: mock production previews.
DATA_SOURCE=
# Optional runtime mode; normally supplied by the runtime.
NODE_ENV=
# Required: OpenRouter dashboard API key, server-only.
OPENROUTER_API_KEY=
# ─── Optional — blank means the schema default in packages/env/src/server.ts ──

# Primary model for agent turns (default anthropic/claude-sonnet-4.5).
AGENT_MODEL=
# Small, fast model behind the scope gate (PRD 10.8); runs on every inbound
# message before the primary model, so keep it cheap (default anthropic/claude-haiku-4.5).
AGENT_GATE_MODEL=
# Base mainnet RPC (default https://mainnet.base.org). The public endpoint is fine
# for development; use a keyed provider if you start hitting rate limits.
BASE_RPC_URL=
# Legacy order-feed override; unused by the SDK-backed order adapter.
THETANUTS_ORDERS_URL=
# Public platform referrer, passed to every OptionBook quote and fill. The
# owner-approved default is in the schema; set this only to override it.
THESIS_REFERRER=
# Vercel sync defaults to apps/web/.env, not .env.local. Pass the intended file
# explicitly to the sync script when secrets live only in .env.local.

# ─── Developer switches (read directly, never set in production) ─────────────
# drizzle-kit refuses a non-loopback target unless this is 1. Set it ONLY for the
# deliberate production migration (`drizzle-kit migrate`, never `push`).
DRIZZLE_ALLOW_REMOTE=
# The test suites write and delete rows, so they refuse a non-loopback DATABASE_URL
# unless this is 1. Leave blank; use a local throwaway database instead.
TEST_DATABASE_OK=
# 1 runs the live order-book quote suite against Thetanuts over the network.
LIVE_BOOK_TESTS=
