{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"tasks": {
		"build": {
			"dependsOn": [
				"^build"
			],
			"inputs": [
				"$TURBO_DEFAULT$",
				".env*"
			],
			"env": [
				"NODE_ENV",
				"DATABASE_URL",
				"DIRECT_DATABASE_URL",
				"SESSION_SECRET",
				"DATA_SOURCE",
				"AI_GATEWAY_API_KEY",
				"NEYNAR_API_KEY",
				"OPENROUTER_API_KEY",
				"AGENT_MODEL",
				"AGENT_GATE_MODEL",
				"BASE_RPC_URL",
				"THESIS_REFERRER",
				"THETANUTS_ORDERS_URL",
				"SKIP_ENV_VALIDATION"
			],
			"outputs": [
				"dist/**",
				".next/**",
				"!.next/cache/**"
			]
		},
		"lint": {
			"dependsOn": [
				"^lint"
			]
		},
		"check-types": {
			"dependsOn": [
				"^check-types"
			]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"db:push": {
			"cache": false,
			"interactive": true
		},
		"db:generate": {
			"cache": false,
			"interactive": true
		},
		"db:migrate": {
			"cache": false,
			"interactive": true
		},
		"db:studio": {
			"cache": false,
			"persistent": true
		}
	}
}
